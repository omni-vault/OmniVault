{
  "manifest_version": 3,
  "name": "OmniVault",
  "description": "Ein unabhängiger Client für mehrere Passwortmanager: Einträge suchen, kopieren und ausfüllen.",
  "version": "0.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "alarms",
    "idle",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://*.bitwarden.com/*",
    "https://*.bitwarden.eu/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "OmniVault öffnen"
    },
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Passenden Login auf der aktuellen Seite ausfüllen"
    }
  },
  "optional_permissions": [
    "nativeMessaging",
    "cookies"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inline-menu.html",
        "save-bar.html",
        "passkey.html",
        "icons/icon32.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
